{
  "name": "pam-min-side-microfrontend",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/node": "11.1.3",
    "@astrojs/react": "7.1.2",
    "@navikt/aksel-icons": "8.20.1",
    "@navikt/ds-css": "8.20.1",
    "@navikt/ds-react": "8.20.1",
    "@navikt/nav-dekoratoren-moduler": "3.7.3",
    "@navikt/oasis": "3.8.0",
    "@navikt/pino-logger": "5.0.1",
    "astro": "7.3.3",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "postcss": "8.5.32",
    "postcss-prefix-selector": "2.2.1",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,astro}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
